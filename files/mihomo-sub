echo "Content-Type: text/plain"
echo ""

# Extract RAW URL parameter
RAW=$(echo "$QUERY_STRING" | sed -n 's/.*url=\(.*\)$/\1/p' | cut -d'&' -f1)

# Safe URL Decode function
urldecode() {
    printf '%b\n' "$(echo "$1" | sed 's/+/ /g; s/%/\\x/g')"
}

# Safe URL Encode function for API string
urlencode() {
    echo "$1" | awk -v ORS="" '{
        gsub(/%/, "%25")
        gsub(/&/, "%26")
        gsub(/\+/, "%2B")
        gsub(/#/, "%23")
        gsub(/\?/, "%3F")
        print
    }'
}
