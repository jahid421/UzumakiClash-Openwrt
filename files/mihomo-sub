#!/bin/sh
# UzumakiClash - Turbo Charged Subscription Downloader & Converter Engine

TMP="/tmp/uzsub_$$.raw"
OUT="/tmp/uzsub_$$.yaml"
trap 'rm -f /tmp/uzsub_$$.*' EXIT

urldecode() {
    local url_encoded="${1//+/ }"
    printf '%b' "${url_encoded//%/\\x}" 2>/dev/null || echo "$1"
}

urlencode() {
    local string="${1}"
    local strlen=${#string}
    local encoded=""
    local i=1
    while [ $i -le $strlen ]; do
        local c=$(echo "$string" | cut -c $i)
        case "$c" in
            [a-zA-Z0-9.~_-]) o="${c}" ;;
            *) o=$(printf '%%%02X' "'$c") ;;
        esac
        encoded="${encoded}${o}"
        i=$((i + 1))
    done
    echo "${encoded}"
}

URL=""
if [ "$REQUEST_METHOD" = "POST" ]; then
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
        INPUT_DATA=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
    else
        INPUT_DATA=$(cat 2>/dev/null)
    fi
    
    if echo "$INPUT_DATA" | grep -q '^url='; then
        RAW=$(echo "$INPUT_DATA" | sed -n 's/^url=//p')
        URL=$(urldecode "$RAW")
    else
        URL=$(echo "$INPUT_DATA" | tr -d '\r\n')
    fi
else
    RAW=$(echo "$QUERY_STRING" | grep -oE '(^|&)url=[^&]*' | cut -d= -f2)
    URL=$(urldecode "$RAW")
fi

URL=$(echo "$URL" | awk '{$1=$1;print}')

if [ -z "$URL" ]; then
    echo "Content-Type: text/plain"
    echo ""
    echo "NO_URL"
    exit 0
fi

# 1. Download Direct Link
curl -4 -sL -k \
  --connect-timeout 10 \
  --max-time 30 \
  --tcp-fastopen \
  -A "ClashMeta/1.18.0" \
  -o "$TMP" "$URL" 2>/dev/null

if [ ! -s "$TMP" ]; then
    echo "Content-Type: text/plain"
    echo ""
    echo "DOWNLOAD_FAILED"
    exit 0
fi

tr -d '\r' < "$TMP" > "$OUT" 2>/dev/null || cp "$TMP" "$OUT"

# 2. Check & Decode Base64 Content
if ! grep -qE '^proxies:|^proxy-providers:|^proxy-groups:' "$OUT"; then
    if base64 -d < "$OUT" > "${OUT}.dec" 2>/dev/null && [ -s "${OUT}.dec" ]; then
        if grep -qE '^proxies:|^proxy-providers:' "${OUT}.dec"; then
            mv "${OUT}.dec" "$OUT"
        fi
    fi
fi

# 3. Subconverter API Fallbacks
if ! grep -qE '^proxies:|^proxy-providers:' "$OUT"; then
    URL_ENC=$(urlencode "$URL")
    
    curl -4 -sL -k \
      --connect-timeout 12 \
      --max-time 45 \
      --tcp-fastopen \
      -A "ClashMeta/1.18.0" \
      -o "$OUT" \
      "https://api.v1.mk/sub?target=clash&insert=true&emoji=true&list=false&url=${URL_ENC}" 2>/dev/null

    if ! grep -qE '^proxies:|^proxy-providers:' "$OUT"; then
        curl -4 -sL -k \
          --connect-timeout 12 \
          --max-time 45 \
          --tcp-fastopen \
          -A "ClashMeta/1.18.0" \
          -o "$OUT" \
          "https://sub.id9.cc/sub?target=clash&insert=true&emoji=true&list=false&url=${URL_ENC}" 2>/dev/null
    fi
fi

# 4. Forward to Config Engine
if grep -qE '^proxies:|^proxy-providers:' "$OUT"; then
    export REQUEST_METHOD="POST"
    cat "$OUT" | /www/cgi-bin/mihomo-cfg
else
    echo "Content-Type: text/plain"
    echo ""
    echo "CONVERSION_FAILED"
fi
