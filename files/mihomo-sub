#!/bin/sh
echo "Content-Type: text/plain"
echo ""

RAW=$(echo "$QUERY_STRING" | sed -n 's/.*url=\(.*\)$/\1/p')
URL=$(printf '%b' "$(echo "$RAW" | sed 's/+/ /g; s/%/\\x/g')")
TMP="/tmp/uzsub_$$.yaml"

trap "rm -f ${TMP}* /tmp/uzsub_err.log" EXIT
[ -z "$URL" ] && echo "NO_URL" && exit 0

SUB_CONV="https://api.v1.mk/sub?target=clash&insert=true&emoji=true&list=true&url="
curl -sL --connect-timeout 15 --max-time 90 -H "User-Agent: ClashMeta/1.18.0" -o "$TMP" "$URL" 2>/dev/null

if [ ! -s "$TMP" ] || ! grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
    curl -sL --connect-timeout 15 --max-time 90 -o "$TMP" "${SUB_CONV}$(echo "$URL" | sed 's/&/%26/g')" 2>/dev/null
fi

if [ -s "$TMP" ] && grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
    export REQUEST_METHOD="POST"
    cat "$TMP" | /www/cgi-bin/mihomo-cfg
else
    echo "DOWNLOAD_OR_CONVERSION_FAILED"
fi
