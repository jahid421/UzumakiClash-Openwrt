#!/bin/sh
# ═══════════════════════════════════════════════
# 🌀 UzumakiClash - Smart Subscription Parser
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

RAW=$(echo "$QUERY_STRING" | sed -n 's/.*url=\(.*\)$/\1/p')
# URL Decode
URL=$(printf '%b' "$(echo "$RAW" | sed 's/+/ /g; s/%/\\x/g')")
TMP="/tmp/uzsub_$$.yaml"

trap "rm -f ${TMP}* /tmp/uzsub_err.log" EXIT

if [ -z "$URL" ]; then
    echo "NO_URL"
    exit 0
fi

# 1. Try Direct Download with Mihomo User-Agent
curl -sL --connect-timeout 15 --max-time 90 -A "Mihomo/1.18.0 (Clash.Meta)" -o "$TMP" "$URL" 2>/dev/null

# Check valid Clash YAML
if [ -s "$TMP" ] && grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
    VALID=1
else
    VALID=0
fi

# 2. Fallback to Subconverter
if [ "$VALID" -eq 0 ]; then
    ENCODED_URL=$(echo "$URL" | sed 's/&/%26/g; s/?/%3F/g; s/=/%3D/g; s/#/%23/g; s/+/%2B/g')

    SUB_CONV1="https://api.v1.mk/sub?target=clash&insert=true&emoji=true&list=true&url=${ENCODED_URL}"
    SUB_CONV2="https://sub.id9.cc/sub?target=clash&insert=true&emoji=true&list=true&url=${ENCODED_URL}"

    curl -sL --connect-timeout 15 --max-time 90 -A "Mihomo/1.18.0" -o "$TMP" "$SUB_CONV1" 2>/dev/null

    if [ ! -s "$TMP" ] || ! grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
        curl -sL --connect-timeout 15 --max-time 90 -A "Mihomo/1.18.0" -o "$TMP" "$SUB_CONV2" 2>/dev/null
    fi
fi

# 3. Pipe through Uzumaki Mihomo-CFG Engine
if [ -s "$TMP" ] && grep -q "^proxies:\|^proxy-providers:" "$TMP"; then
    export REQUEST_METHOD="POST"
    
    CFG_BIN="/www/cgi-bin/mihomo-cfg"
    if [ ! -x "$CFG_BIN" ]; then
        CFG_BIN="/usr/bin/mihomo-cfg"
    fi

    cat "$TMP" | "$CFG_BIN"
else
    echo "DOWNLOAD_OR_CONVERSION_FAILED"
fi
