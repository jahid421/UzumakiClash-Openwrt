#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

start_service() {
    [ -f "$CONF_DIR/enabled" ] && [ "$(cat "$CONF_DIR/enabled")" = "0" ] && return 0
    
    ip rule add fwmark 1 table 100 2>/dev/null
    ip route add local default dev lo table 100 2>/dev/null
    
    export GOMEMLIMIT=64MiB
    procd_open_instance mihomo
    procd_set_param command "$PROG" -d "$CONF_DIR" -f "$CONF_DIR/config.yaml"
    procd_set_param respawn 3600 5 5
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance
    
    sleep 2
    if [ -f "$CONF_DIR/transparent" ] && [ "$(cat "$CONF_DIR/transparent")" = "1" ]; then
        nft delete table inet uzumaki 2>/dev/null
        nft -f "$CONF_DIR/nft.conf"
    fi
}

stop_service() {
    nft delete table inet uzumaki 2>/dev/null
    ip rule del fwmark 1 table 100 2>/dev/null
    ip route del local default dev lo table 100 2>/dev/null
    killall -9 mihomo 2>/dev/null
}
