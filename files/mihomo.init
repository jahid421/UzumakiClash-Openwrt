#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

TPROXY_TABLE="24680"
TPROXY_MARK="0x1/0x1"
TPROXY_PRIORITY="10000"

setup_tproxy_route() {
    ip rule del \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    ip rule add \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route flush table "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route add \
        local 0.0.0.0/0 \
        dev lo \
        table "$TPROXY_TABLE" \
        2>/dev/null || true
}

remove_tproxy_route() {
    ip rule del \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route flush table "$TPROXY_TABLE" \
        2>/dev/null || true
}

apply_acl() {
    ACL_FILE="$CONF_DIR/acl-bypass"

    [ -f "$ACL_FILE" ] || return 0
    [ -r "$ACL_FILE" ] || return 0

    while IFS= read -r IP
    do
        [ -z "$IP" ] && continue

        nft add element ip uzumaki acl_ips \
            "{ $IP }" \
            2>/dev/null || true

    done < "$ACL_FILE"
}

apply_nft() {
    NFT_FILE="$CONF_DIR/nft.conf"

    [ -f "$NFT_FILE" ] || return 0

    if ! nft -c -f "$NFT_FILE" >/tmp/uzumaki-nft-test.log 2>&1
    then
        logger -t uzumakiclash "nft syntax check failed"
        return 1
    fi

    nft delete table ip uzumaki \
        2>/dev/null || true

    nft delete table inet uzumaki \
        2>/dev/null || true

    if ! nft -f "$NFT_FILE" >/tmp/uzumaki-nft.log 2>&1
    then
        logger -t uzumakiclash "nft apply failed"
        return 1
    fi

    apply_acl

    return 0
}

start_service() {

    [ -x "$PROG" ] || {
        logger -t uzumakiclash "Mihomo binary not found"
        return 1
    }

    [ -f "$CONF_DIR/config.yaml" ] || {
        logger -t uzumakiclash "config.yaml not found"
        return 1
    }

    [ -f "$CONF_DIR/enabled" ] || \
        echo "1" > "$CONF_DIR/enabled"

    [ -f "$CONF_DIR/transparent" ] || \
        echo "1" > "$CONF_DIR/transparent"

    if [ "$(cat "$CONF_DIR/enabled" 2>/dev/null)" = "0" ]
    then
        return 0
    fi

    export GOMEMLIMIT=40MiB
    export GOGC=20

    # Only procd manages the Mihomo process.
    procd_open_instance "mihomo"

    procd_set_param command \
        "$PROG" \
        -d "$CONF_DIR" \
        -f "$CONF_DIR/config.yaml"

    procd_set_param respawn 3600 5 5

    procd_close_instance

    # Network interception is configured after the process is registered.
    (
        sleep 3

        setup_tproxy_route

        if [ "$(cat "$CONF_DIR/transparent" 2>/dev/null)" = "1" ]
        then
            apply_nft
        fi
    ) &
}

stop_service() {

    nft delete table ip uzumaki \
        2>/dev/null || true

    nft delete table inet uzumaki \
        2>/dev/null || true

    remove_tproxy_route

    killall -9 mihomo \
        2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger \
        "mihomo" \
        "network" \
        "firewall"
}
