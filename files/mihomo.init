#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

TPROXY_TABLE="24680"
TPROXY_MARK="1"

# ==========================================================
# TPROXY ROUTING
# ==========================================================
setup_tproxy_route() {

    ip rule del \
        fwmark "$TPROXY_MARK" \
        table "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route flush \
        table "$TPROXY_TABLE" \
        2>/dev/null || true

    ip rule add \
        fwmark "$TPROXY_MARK" \
        table "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route add \
        local 0.0.0.0/0 \
        dev lo \
        table "$TPROXY_TABLE" \
        2>/dev/null || true
}

clear_tproxy_route() {

    ip rule del \
        fwmark "$TPROXY_MARK" \
        table "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route flush \
        table "$TPROXY_TABLE" \
        2>/dev/null || true
}

# ==========================================================
# START
# ==========================================================
start_service() {

    [ -x "$PROG" ] || return 1

    [ -f "$CONF_DIR/config.yaml" ] || return 1

    if [ -f "$CONF_DIR/enabled" ] &&
       [ "$(cat "$CONF_DIR/enabled" 2>/dev/null)" = "0" ]; then

        return 0
    fi

    # Keep memory control, but don't force aggressive GOGC.
    export GOMEMLIMIT=64MiB

    # Set policy routing before transparent UDP starts.
    setup_tproxy_route

    # Procd is the only process supervisor.
    procd_open_instance mihomo

    procd_set_param command \
        "$PROG" \
        -d "$CONF_DIR" \
        -f "$CONF_DIR/config.yaml"

    procd_set_param respawn \
        3600 5 5

    procd_set_param limits \
        nofile="65535 65535"

    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_set_param pidfile \
        /var/run/mihomo.pid

    procd_close_instance

    sleep 1

    # ======================================================
    # Transparent proxy
    # ======================================================
    if [ -f "$CONF_DIR/transparent" ] &&
       [ "$(cat "$CONF_DIR/transparent" 2>/dev/null)" = "1" ]; then

        nft delete table ip uzumaki \
            2>/dev/null || true

        nft delete table inet uzumaki \
            2>/dev/null || true

        nft -f "$CONF_DIR/nft.conf" \
            >/tmp/uzumaki-nft.log 2>&1 || true
    fi
}

# ==========================================================
# STOP
# ==========================================================
stop_service() {

    nft delete table ip uzumaki \
        2>/dev/null || true

    nft delete table inet uzumaki \
        2>/dev/null || true

    clear_tproxy_route

    killall -9 mihomo \
        2>/dev/null || true

    rm -f /var/run/mihomo.pid
}

# ==========================================================
# BOOT
# ==========================================================
boot() {

    sleep 5

    start
}

# ==========================================================
# TRIGGERS
# ==========================================================
service_triggers() {

    procd_add_reload_trigger network firewall
}
