#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

start_service() {
    [ -x "$PROG" ] || return 1
    [ -f "$CONF_DIR/config.yaml" ] || return 1

    [ -f "$CONF_DIR/enabled" ] || echo "1" > "$CONF_DIR/enabled"
    [ -f "$CONF_DIR/transparent" ] || echo "1" > "$CONF_DIR/transparent"

    [ "$(cat "$CONF_DIR/enabled" 2>/dev/null)" = "0" ] && return 0

    export GOMEMLIMIT=40MiB
    export GOGC=20

    # Remove stale process before creating the procd instance.
    killall mihomo 2>/dev/null || true

    procd_open_instance "mihomo"

    procd_set_param command \
        "$PROG" \
        -d "$CONF_DIR" \
        -f "$CONF_DIR/config.yaml"

    procd_set_param respawn 3600 5 5

    procd_set_param limits \
        nofile="1048576 1048576"

    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance

    # Apply TPROXY routing after Mihomo has started.
    (
        sleep 3

        if [ -f "$CONF_DIR/transparent" ] &&
           [ "$(cat "$CONF_DIR/transparent" 2>/dev/null)" = "1"
        ]; then

            # TPROXY policy routing.
            ip rule del \
                pref 10000 \
                fwmark 0x1/0x1 \
                lookup 24680 \
                2>/dev/null || true

            ip rule add \
                pref 10000 \
                fwmark 0x1/0x1 \
                lookup 24680 \
                2>/dev/null || true

            ip route flush table 24680 2>/dev/null || true

            ip route add \
                local 0.0.0.0/0 \
                dev lo \
                table 24680 \
                2>/dev/null || true

            if [ -f "$CONF_DIR/nft.conf" ]; then
                nft -c -f "$CONF_DIR/nft.conf" \
                    >/tmp/uzumaki-nft-test.log 2>&1

                if [ $? -eq 0 ]; then
                    nft delete table ip uzumaki \
                        2>/dev/null || true

                    nft -f "$CONF_DIR/nft.conf" \
                        >/tmp/uzumaki-nft.log 2>&1
                fi
            fi
        fi
    ) &
}

stop_service() {

    nft delete table ip uzumaki \
        2>/dev/null || true

    nft delete table inet uzumaki \
        2>/dev/null || true

    ip rule del \
        pref 10000 \
        fwmark 0x1/0x1 \
        lookup 24680 \
        2>/dev/null || true

    ip route flush table 24680 \
        2>/dev/null || true

    killall -9 mihomo \
        2>/dev/null || true
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger \
        "mihomo" "network" "firewall"
}
