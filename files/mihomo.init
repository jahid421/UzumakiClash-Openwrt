#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10
CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

start_service() {
    if [ -f "$CONF_DIR/enabled" ] && [ "$(cat "$CONF_DIR/enabled")" = "0" ]; then
        return 0
    fi

    # TPROXY Routing rules (Essential for Gaming)
    ip rule add fwmark 1 table 100 2>/dev/null
    ip route add local default dev lo table 100 2>/dev/null

    export GOMEMLIMIT=64MiB
    export GOGC=30

    procd_open_instance mihomo
    procd_set_param command "$PROG" -d "$CONF_DIR" -f "$CONF_DIR/config.yaml"
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance

    sleep 3

    if [ -f "$CONF_DIR/transparent" ] && [ "$(cat "$CONF_DIR/transparent")" = "1" ]; then
        /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true
        /usr/sbin/nft -f "$CONF_DIR/nft.conf" 2>/dev/null || true
    fi
}

stop_service() {
    /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true
    ip rule del fwmark 1 table 100 2>/dev/null
    ip route del local default dev lo table 100 2>/dev/null
    killall -9 mihomo 2>/dev/null || true
    rm -f /var/run/mihomo.pid
}

service_triggers() {
    procd_add_reload_trigger "mihomo" "network" "firewall"
}
