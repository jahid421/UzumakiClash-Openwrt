#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

start_service() {
    [ -f "$CONF_DIR/enabled" ] && [ "$(cat "$CONF_DIR/enabled")" = "0" ] && return 0

    export GOMEMLIMIT=40MiB
    export GOGC=20

    procd_open_instance mihomo
    procd_set_param command "$PROG" -d "$CONF_DIR" -f "$CONF_DIR/config.yaml"
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance

    sleep 2

    if [ -f "$CONF_DIR/transparent" ] && [ "$(cat "$CONF_DIR/transparent")" = "1" ]; then
        nft delete table ip uzumaki 2>/dev/null || true
        nft -f "$CONF_DIR/nft.conf" 2>/dev/null || true
    fi
}

stop_service() {
    nft delete table ip uzumaki 2>/dev/null || true
    killall -9 mihomo 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "mihomo"
}
