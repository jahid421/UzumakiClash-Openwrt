#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

TPROXY_TABLE="24680"
TPROXY_MARK="0x1/0x1"
TPROXY_PRIORITY="10000"

boot() {
    sleep 5
    start
}

setup_tproxy_route() {
    # Remove an old duplicate rule if present.
    ip rule del \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    # Add the TPROXY policy rule.
    ip rule add \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    # Marked packets must be delivered locally to Mihomo.
    ip route replace \
        local 0.0.0.0/0 \
        dev lo \
        table "$TPROXY_TABLE" \
        2>/dev/null || \
    ip route add \
        local 0.0.0.0/0 \
        dev lo \
        table "$TPROXY_TABLE" \
        2>/dev/null || true
}

remove_tproxy_route() {
    ip rule del \
        pref "$TPROXY_PRIORITY" \
        fwmark "$TPROXY_MARK" \
        lookup "$TPROXY_TABLE" \
        2>/dev/null || true

    ip route flush table "$TPROXY_TABLE" \
        2>/dev/null || true
}

apply_acl() {
    ACL_FILE="$CONF_DIR/acl_ips"

    [ -f "$ACL_FILE" ] || return 0

    while IFS= read -r IP
    do
        [ -z "$IP" ] && continue

        nft add element ip uzumaki acl_ips \
            "{ $IP }" \
            2>/dev/null || true

    done < "$ACL_FILE"
}

apply_nft() {
    NFT_FILE="$CONF_DIR/nft.conf"

    [ -f "$NFT_FILE" ] || return 1

    nft delete table ip uzumaki \
        2>/dev/null || true

    if ! nft -f "$NFT_FILE" 2>/dev/null; then
        return 1
    fi

    apply_acl

    return 0
}

remove_nft() {
    nft delete table ip uzumaki \
        2>/dev/null || true

    nft delete table inet uzumaki \
        2>/dev/null || true
}

start_service() {

    [ -x "$PROG" ] || return 1
    [ -f "$CONF_DIR/config.yaml" ] || return 1

    # Create default state files only when missing.
    [ -f "$CONF_DIR/enabled" ] || \
        echo "1" > "$CONF_DIR/enabled"

    [ -f "$CONF_DIR/transparent" ] || \
        echo "1" > "$CONF_DIR/transparent"

    # Explicitly disabled.
    [ "$(cat "$CONF_DIR/enabled" 2>/dev/null)" = "0" ] && \
        return 0

    # Memory tuning.
    export GOMEMLIMIT=40MiB
    export GOGC=20

    # Start Mihomo under procd.
    procd_open_instance mihomo

    procd_set_param command \
        "$PROG" \
        -d "$CONF_DIR" \
        -f "$CONF_DIR/config.yaml"

    procd_set_param respawn 3600 5 5

    procd_set_param limits \
        nofile="1048576 1048576"

    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_set_param pidfile \
        /var/run/mihomo.pid

    procd_close_instance

    # Apply routing after Mihomo has had time to bind its ports.
    (
        sleep 3

        setup_tproxy_route

        if [ -f "$CONF_DIR/transparent" ] &&
           [ "$(cat "$CONF_DIR/transparent" 2>/dev/null)" = "1" ]
        then
            apply_nft >/dev/null 2>&1 || true
        fi
    ) &

}

stop_service() {

    # Remove interception first.
    remove_nft

    # Remove TPROXY policy routing.
    remove_tproxy_route

    # Stop Mihomo.
    killall -9 mihomo \
        2>/dev/null || true

    rm -f /var/run/mihomo.pid
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger "mihomo" "network" "firewall"
}
