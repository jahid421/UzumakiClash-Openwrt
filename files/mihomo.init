#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

MARK="0x1"
TABLE="24680"

setup_policy_route() {
    # Remove stale rule first.
    ip rule del fwmark "$MARK/0x1" table "$TABLE" 2>/dev/null || true

    # Add the required fwmark policy rule.
    ip rule add fwmark "$MARK/0x1" table "$TABLE" 2>/dev/null || true

    # TPROXY requires marked traffic to be delivered locally.
    ip route replace local 0.0.0.0/0 dev lo table "$TABLE" 2>/dev/null || {
        ip route flush table "$TABLE" 2>/dev/null || true
        ip route add local 0.0.0.0/0 dev lo table "$TABLE" 2>/dev/null || true
    }
}

remove_policy_route() {
    ip rule del fwmark "$MARK/0x1" table "$TABLE" 2>/dev/null || true
    ip route flush table "$TABLE" 2>/dev/null || true
}

apply_acl() {
    local ip

    [ -f "$CONF_DIR/acl_ips" ] || return 0

    while IFS= read -r ip; do
        [ -z "$ip" ] && continue

        /usr/sbin/nft add element ip uzumaki acl_ips "{ $ip }" \
            2>/dev/null || true
    done < "$CONF_DIR/acl_ips"
}

apply_nft() {
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true

    if [ -f "$CONF_DIR/nft.conf" ]; then
        /usr/sbin/nft -f "$CONF_DIR/nft.conf" 2>/dev/null || return 1
        apply_acl
    fi

    return 0
}

boot() {
    sleep 5
    start
}

start_service() {

    [ -x "$PROG" ] || return 1
    [ -f "$CONF_DIR/config.yaml" ] || return 1

    [ -f "$CONF_DIR/enabled" ] || \
        echo "1" > "$CONF_DIR/enabled"

    [ -f "$CONF_DIR/transparent" ] || \
        echo "1" > "$CONF_DIR/transparent"

    [ "$(cat "$CONF_DIR/enabled" 2>/dev/null)" = "0" ] && \
        return 0

    export GOMEMLIMIT=40MiB
    export GOGC=20

    procd_open_instance mihomo

    procd_set_param command \
        "$PROG" \
        -d "$CONF_DIR" \
        -f "$CONF_DIR/config.yaml"

    procd_set_param respawn 3600 5 5

    procd_set_param limits \
        nofile="1048576 1048576"

    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_set_param pidfile /var/run/mihomo.pid

    procd_close_instance

    (
        sleep 3

        setup_policy_route

        if [ -f "$CONF_DIR/transparent" ] &&
           [ "$(cat "$CONF_DIR/transparent" 2>/dev/null)" = "1" ]; then

            apply_nft
        fi
    ) &
}

stop_service() {

    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
    /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true

    remove_policy_route

    killall -9 mihomo 2>/dev/null || true

    rm -f /var/run/mihomo.pid
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger "mihomo" "network" "firewall"
}
