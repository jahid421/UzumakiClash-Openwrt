#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
CONF_DIR="/etc/mihomo"
PROG="/usr/bin/mihomo"

boot() {
    sleep 5
    start
}

start_service() {
    if [ -f "$CONF_DIR/enabled" ] && [ "$(cat "$CONF_DIR/enabled")" = "0" ]; then
        return 0
    fi
    
    # মেমোরি ও ওওএম ক্র্যাশ প্রোটেকশন
    export GOMEMLIMIT=100MiB
    export GOGC=30

    procd_open_instance "mihomo"
    procd_set_param command "$PROG" -d "$CONF_DIR" -f "$CONF_DIR/config.yaml"
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="65535 65535" # বাজেট ফ্রেন্ডলি সেফ লিমিট
    procd_set_param pidfile /var/run/mihomo.pid
    procd_close_instance
    
    sleep 3
    if [ -f "$CONF_DIR/transparent" ] && [ "$(cat "$CONF_DIR/transparent")" = "1" ]; then
        /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
        /usr/sbin/nft -f "$CONF_DIR/nft.conf" 2>/dev/null || true
    fi
}

stop_service() {
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
    killall -9 mihomo 2>/dev/null || true
    rm -f /var/run/mihomo.pid
}

service_triggers() {
    procd_add_reload_trigger "mihomo" "network" "firewall"
}
