#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
	if [ -f "/etc/mihomo/enabled" ] && [ "$(cat "/etc/mihomo/enabled")" = "0" ]; then
		return 0
	fi
	export GOMEMLIMIT=40MiB
	export GOGC=80
	export GODEBUG=madvdontneed=1

	procd_open_instance mihomo
	procd_set_param command /usr/bin/mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	sleep 2
	if [ -f "/etc/mihomo/transparent" ] && [ "$(cat "/etc/mihomo/transparent")" = "1" ]; then
		/usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
		/usr/sbin/nft -f /etc/mihomo/nft.conf 2>/dev/null || true
	fi
}

stop_service() {
	/usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
}
