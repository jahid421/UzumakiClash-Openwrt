#!/bin/sh

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

echo "Content-Type: application/json"
echo ""

CONF_DIR="/etc/mihomo"
TRANSPARENT_FILE="$CONF_DIR/transparent"
ENABLED_FILE="$CONF_DIR/enabled"
NFT_FILE="$CONF_DIR/nft.conf"

ACTION=$(
    printf '%s\n' "$QUERY_STRING" |
    tr '&' '\n' |
    sed -n 's/^action=//p' |
    head -n 1
)

json_ok() {
    echo '{"ok":true}'
}

json_error() {
    echo "{\"ok\":false,\"error\":\"$1\"}"
}

apply_nft() {
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true

    [ -f "$NFT_FILE" ] || return 1

    /usr/sbin/nft -f "$NFT_FILE" 2>/dev/null || return 1

    if [ -f "$CONF_DIR/acl_ips" ]; then
        while IFS= read -r IP; do
            [ -z "$IP" ] && continue

            /usr/sbin/nft add element ip uzumaki acl_ips "{ $IP }" \
                2>/dev/null || true
        done < "$CONF_DIR/acl_ips"
    fi

    return 0
}

remove_nft() {
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
    /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true
}

case "$ACTION" in

    status)

        ENABLED="1"
        [ -f "$ENABLED_FILE" ] &&
            ENABLED=$(cat "$ENABLED_FILE" 2>/dev/null)

        TP="0"
        [ -f "$TRANSPARENT_FILE" ] &&
            TP=$(cat "$TRANSPARENT_FILE" 2>/dev/null)

        PID=$(pgrep -f '^/usr/bin/mihomo' 2>/dev/null | head -n 1)

        if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then

            MEM=$(
                awk '/VmRSS:/ {print $2}' \
                    "/proc/$PID/status" 2>/dev/null
            )

            [ -z "$MEM" ] && MEM="0"

            echo "{\"running\":true,\"pid\":$PID,\"memory\":\"${MEM} kB\",\"transparent\":$TP,\"enabled\":$ENABLED}"

        else

            echo "{\"running\":false,\"transparent\":$TP,\"enabled\":$ENABLED}"

        fi

        ;;

    start)

        echo "1" > "$ENABLED_FILE"
        echo "1" > "$TRANSPARENT_FILE"

        /etc/init.d/mihomo restart >/dev/null 2>&1

        sleep 2

        if apply_nft; then
            json_ok
        else
            json_error "NFT_APPLY_FAILED"
        fi

        ;;

    stop)

        echo "0" > "$ENABLED_FILE"
        echo "0" > "$TRANSPARENT_FILE"

        remove_nft

        /etc/init.d/mihomo stop >/dev/null 2>&1
        killall -9 mihomo 2>/dev/null || true

        rm -f /var/run/mihomo.pid

        json_ok

        ;;

    restart)

        echo "1" > "$ENABLED_FILE"

        /etc/init.d/mihomo restart >/dev/null 2>&1

        sleep 2

        if [ -f "$TRANSPARENT_FILE" ] &&
           [ "$(cat "$TRANSPARENT_FILE" 2>/dev/null)" = "1" ]; then

            if apply_nft; then
                json_ok
            else
                json_error "NFT_APPLY_FAILED"
            fi
        else
            json_ok
        fi

        ;;

    enable_tp)

        echo "1" > "$TRANSPARENT_FILE"

        if apply_nft; then
            json_ok
        else
            json_error "NFT_APPLY_FAILED"
        fi

        ;;

    disable_tp)

        echo "0" > "$TRANSPARENT_FILE"

        remove_nft

        json_ok

        ;;

    flush_fakeip)

        curl -fsS \
            -X POST \
            "http://127.0.0.1:9595/cache/fakeip/flush" \
            -H "Authorization: Bearer flclash123" \
            >/dev/null 2>&1

        if [ $? -eq 0 ]; then
            json_ok
        else
            json_error "FAKEIP_FLUSH_FAILED"
        fi

        ;;

    update_geo)

        (
            cd "$CONF_DIR" || exit 1

            curl -fsSL \
                -o geoip.dat \
                "https://github.com/MetaCubeX/meta-rules-dat/releases/latest/download/geoip-lite.dat"

            curl -fsSL \
                -o geosite.dat \
                "https://github.com/MetaCubeX/meta-rules-dat/releases/latest/download/geosite.dat"

            curl -fsSL \
                -o Country.mmdb \
                "https://github.com/MetaCubeX/meta-rules-dat/releases/latest/download/country-lite.mmdb"

        ) >/dev/null 2>&1 &

        echo '{"ok":true,"message":"Updating in background"}"

        ;;

    add_acl_bypass)

        IP=$(
            printf '%s\n' "$QUERY_STRING" |
            tr '&' '\n' |
            sed -n 's/^ip=//p' |
            head -n 1
        )

        IP=$(
            printf '%b' \
            "$(printf '%s' "$IP" | sed 's/+/ /g;s/%/\\x/g')"
        )

        if ! printf '%s' "$IP" |
            grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
        then
            json_error "INVALID_IP"
            exit 1
        fi

        OLDIFS="$IFS"
        IFS=.
        set -- $IP
        IFS="$OLDIFS"

        for OCTET in "$@"; do
            [ "$OCTET" -le 255 ] 2>/dev/null || {
                json_error "INVALID_IP"
                exit 1
            }
        done

        ACL_FILE="$CONF_DIR/acl_ips"

        touch "$ACL_FILE"

        if ! grep -qxF "$IP" "$ACL_FILE" 2>/dev/null; then
            echo "$IP" >> "$ACL_FILE"
        fi

        # Apply immediately when Uzumaki nft table exists.
        /usr/sbin/nft add element ip uzumaki acl_ips "{ $IP }" \
            2>/dev/null || true

        json_ok

        ;;

    *)

        json_error "INVALID_ACTION"

        ;;

esac
