#!/bin/sh
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
echo "Content-Type: application/json"
echo ""

ACTION=$(echo "$QUERY_STRING" | sed -n 's/.*action=\([a-z_]*\).*/\1/p')
IP=$(echo "$QUERY_STRING" | sed -n 's/.*ip=\([0-9.]*\).*/\1/p')
CONF_DIR="/etc/mihomo"
TRANSPARENT_FILE="$CONF_DIR/transparent"
ENABLED_FILE="$CONF_DIR/enabled"

# ⚡ pgrep এর ঝঞ্জাট ছাড়া Busybox ফ্রেন্ডলি প্রসেস আইডি ডিটেকশন
PID=$(ps | grep -v grep | grep "/usr/bin/mihomo" | awk '{print $1}' | head -n 1)

case "$ACTION" in
  status)
    ENABLED="1"; [ -f "$ENABLED_FILE" ] && ENABLED=$(cat "$ENABLED_FILE")
    TP="0"; [ -f "$TRANSPARENT_FILE" ] && TP=$(cat "$TRANSPARENT_FILE")

    if [ -n "$PID" ]; then
      MEM=$(awk '/VmRSS/{print $2}' /proc/$PID/status 2>/dev/null || echo 0)
      echo "{\"running\":true,\"pid\":$PID,\"memory\":\"${MEM} kB\",\"transparent\":$TP,\"enabled\":$ENABLED}"
    else
      echo "{\"running\":false,\"transparent\":$TP,\"enabled\":$ENABLED}"
    fi
    ;;

  start)
    echo "1" > "$ENABLED_FILE"
    echo "1" > "$TRANSPARENT_FILE"
    killall -9 mihomo >/dev/null 2>&1 || true
    rm -f /var/run/mihomo.pid
    /etc/init.d/mihomo restart >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  stop)
    echo "0" > "$ENABLED_FILE"
    echo "0" > "$TRANSPARENT_FILE"
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
    /etc/init.d/mihomo stop >/dev/null 2>&1
    killall -9 mihomo 2>/dev/null || true
    rm -f /var/run/mihomo.pid
    echo "{\"ok\":true}"
    ;;

  restart)
    echo "1" > "$ENABLED_FILE"
    /etc/init.d/mihomo restart >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  enable_tp)
    echo "1" > "$TRANSPARENT_FILE"
    /usr/sbin/nft -f "$CONF_DIR/nft.conf" 2>/dev/null || true
    echo "{\"ok\":true}"
    ;;

  disable_tp)
    echo "0" > "$TRANSPARENT_FILE"
    /usr/sbin/nft delete table ip uzumaki 2>/dev/null || true
    echo "{\"ok\":true}"
    ;;

  # 🛡️ New Feature: Dynamic ACL Device Bypass
  add_acl_bypass)
    if [ -n "$IP" ]; then
        nft add element ip uzumaki acl_bypass { "$IP" } 2>/dev/null || true
        echo "{\"ok\":true,\"ip\":\"$IP\"}"
    else
        echo "{\"ok\":false,\"error\":\"no_ip\"}"
    fi
    ;;

  flush_fakeip)
    curl -s -X POST "http://127.0.0.1:9595/cache/fakeip/flush" -H "Authorization: Bearer flclash123" >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  update_geo)
    (
      cd "$CONF_DIR"
      curl -sL -o geoip.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat"
      curl -sL -o geosite.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat"
      curl -sL -o Country.mmdb "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country-lite.mmdb"
    ) &
    echo "{\"ok\":true,\"message\":\"Updating in background\"}"
    ;;

  *)
    echo "{\"ok\":false,\"error\":\"invalid_action\"}"
    ;;
esac
