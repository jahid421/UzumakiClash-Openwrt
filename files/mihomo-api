#!/bin/sh
# UzumakiClash API Controller & RAM Guardian

API_URL="http://127.0.0.1:9090"
SECRET="uzumaki-clash-secret"
CONF_DIR="/etc/uzumaki"

# API Call Wrapper
api_call() {
    local method="$1"
    local endpoint="$2"
    local data="$3"
    
    curl -s -X "$method" \
        -H "Authorization: Bearer $SECRET" \
        -H "Content-Type: application/json" \
        ${data:+-d "$data"} \
        "$API_URL$endpoint"
}

case "$1" in
    status)
        api_call GET "/version"
        ;;
    
    reload)
        api_call PUT "/configs?force=true" \
            "{\"path\":\"$CONF_DIR/config.yaml\"}"
        ;;
    
    mode)
        api_call PATCH "/configs" "{\"mode\":\"$2\"}"
        ;;
    
    proxies)
        api_call GET "/proxies"
        ;;
    
    switch)
        # $2 = group, $3 = proxy name
        api_call PUT "/proxies/$2" "{\"name\":\"$3\"}"
        ;;
    
    guardian)
        # RAM Guardian: মেমরি বেশি হলে অটো রিস্টার্ট
        MAX_MEM_KB=51200   # 50 MB সীমা
        while true; do
            sleep 60
            PID=$(pidof uzumaki-core)
            [ -z "$PID" ] && continue
            
            MEM_KB=$(awk '/VmRSS/ {print $2}' /proc/$PID/status 2>/dev/null)
            [ -z "$MEM_KB" ] && continue
            
            if [ "$MEM_KB" -gt "$MAX_MEM_KB" ]; then
                logger -t "UzumakiClash" "RAM limit exceeded (${MEM_KB}KB), restarting..."
                /etc/init.d/uzumaki restart
            fi
        done
        ;;
    
    *)
        echo "Usage: $0 {status|reload|mode|proxies|switch|guardian}"
        exit 1
        ;;
esac
