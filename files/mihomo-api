#!/bin/sh
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
echo "Content-Type: application/json"
echo ""

ACTION=$(echo "$QUERY_STRING" | sed -n 's/.*action=\([a-z_]*\).*/\1/p')
CONF_DIR="/etc/mihomo"
TRANSPARENT_FILE="$CONF_DIR/transparent"
ENABLED_FILE="$CONF_DIR/enabled"

setup_tp() {
    ip rule del fwmark 0x1 table 100 2>/dev/null
    ip route flush table 100 2>/dev/null
    ip rule add fwmark 0x1 table 100
    ip route add local 0.0.0.0/0 dev lo table 100
    /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true
    /usr/sbin/nft -f "$CONF_DIR/nft.conf" 2>/dev/null || true
}

flush_tp() {
    ip rule del fwmark 0x1 table 100 2>/dev/null
    ip route flush table 100 2>/dev/null
    /usr/sbin/nft delete table inet uzumaki 2>/dev/null || true
}

case "$ACTION" in
  status)
    ENABLED="1"; [ -f "$ENABLED_FILE" ] && ENABLED=$(cat "$ENABLED_FILE")
    TP="0"; [ -f "$TRANSPARENT_FILE" ] && TP=$(cat "$TRANSPARENT_FILE")

    PID=$(pgrep -f "/usr/bin/mihomo" | head -n 1)
    if [ -n "$PID" ]; then
      MEM=$(awk '/VmRSS/{print $2}' /proc/$PID/status 2>/dev/null || echo 0)
      echo "{\"running\":true,\"pid\":$PID,\"memory\":\"${MEM} kB\",\"transparent\":$TP,\"enabled\":$ENABLED}"
    else
      echo "{\"running\":false,\"transparent\":$TP,\"enabled\":$ENABLED}"
    fi
    ;;

  start)
    echo "1" > "$ENABLED_FILE"
    echo "1" > "$TRANSPARENT_FILE"
    /etc/init.d/mihomo restart >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  stop)
    echo "0" > "$ENABLED_FILE"
    echo "0" > "$TRANSPARENT_FILE"
    /etc/init.d/mihomo stop >/dev/null 2>&1
    flush_tp
    echo "{\"ok\":true}"
    ;;

  restart)
    echo "1" > "$ENABLED_FILE"
    /etc/init.d/mihomo restart >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  enable_tp)
    echo "1" > "$TRANSPARENT_FILE"
    setup_tp
    echo "{\"ok\":true}"
    ;;

  disable_tp)
    echo "0" > "$TRANSPARENT_FILE"
    flush_tp
    echo "{\"ok\":true}"
    ;;

  flush_fakeip)
    curl -s -X POST "http://127.0.0.1:9595/cache/fakeip/flush" -H "Authorization: Bearer flclash123" >/dev/null 2>&1
    echo "{\"ok\":true}"
    ;;

  update_geo)
    (
      cd /etc/mihomo
      curl -sL --connect-timeout 10 --max-time 60 -o geoip.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat" &
      curl -sL --connect-timeout 10 --max-time 60 -o geosite.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat" &
      curl -sL --connect-timeout 10 --max-time 60 -o Country.mmdb "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/country-lite.mmdb" &
      wait
    ) &
    echo "{\"ok\":true,\"message\":\"Updating in background\"}"
    ;;

  *)
    echo "{\"ok\":false,\"error\":\"invalid_action\"}"
    ;;
esac
