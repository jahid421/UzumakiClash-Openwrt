#!/bin/sh
echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/uzcfg_$$.yaml"
    TMP_CLEAN="/tmp/uzcfg_clean_$$.yaml"
    TMP_FINAL="/tmp/uzcfg_final_$$.yaml"
    
    trap "rm -f /tmp/uzcfg_*_$$.yaml /tmp/uzcfg_err.log" EXIT
    tr -d '\r' > "$TMP"
    
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')

        # সিস্টেম হেডার বাদ দিয়ে শুধু ইউজার নোড ও রুলস নেওয়া
        awk '
        BEGIN { skip=0 }
        /^[a-zA-Z0-9_-]+:/ {
            key = $1
            if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|tcp-concurrent|unified-delay|geodata-mode|profile|sniffer|tun|dns):/) {
                skip=1
            } else {
                skip=0
            }
        }
        {
            if (!skip) {
                if ($0 !~ /GEOIP,BD,DIRECT/ && $0 !~ /GEOIP,LAN,DIRECT/) {
                    print $0
                }
            }
        }
        ' "$TMP" > "$TMP_CLEAN"

        # রুলস সেকশনে লোকাল বাইপাস যুক্ত করা
        awk -v lan="$LAN_NET" '
        BEGIN { added=0 }
        /^rules:/ {
            print $0
            if (!added) {
                print "  - IP-CIDR," lan ",DIRECT,no-resolve"
                print "  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
                print "  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
                print "  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
                print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
                print "  - DOMAIN-SUFFIX,local,DIRECT"
                print "  - DOMAIN-SUFFIX,lan,DIRECT"
                print "  - DST-PORT,9595,DIRECT"
                print "  - DOMAIN-SUFFIX,bd,DIRECT"
                print "  - DOMAIN-KEYWORD,bkash,DIRECT"
                print "  - DOMAIN-KEYWORD,nagad,DIRECT"
                added=1
            }
            next
        }
        { print }
        ' "$TMP_CLEAN" > "$TMP"

        # মাস্টার হেডার বসানো
        cat << 'HEOF' > "$TMP_FINAL"
mixed-port: 7890
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"
tcp-concurrent: true
unified-delay: true
geodata-mode: true

tun:
  enable: true
  stack: mixed
  device: uzumaki-tun
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  dns-hijack:
    - "any:53"
    - "tcp://any:53"

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP: { ports: [80, 8080-8880] }
    TLS: { ports: [443, 8443] }
    QUIC: { ports: [443, 8443] }

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'time.*.com'
    - 'ntp.*.com'
    - '+.pool.ntp.org'
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - https://dns.google/dns-query

HEOF
        cat "$TMP" >> "$TMP_FINAL"

        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP_FINAL" -t 2>/tmp/uzcfg_err.log; then
            mv "$TMP_FINAL" /etc/mihomo/config.yaml
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            ERR=$(head -n 3 /tmp/uzcfg_err.log 2>/dev/null)
            echo "INVALID YAML: $ERR"
        fi
    else
        echo "EMPTY"
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
