#!/bin/sh
echo "Content-Type: text/plain"
echo ""

CONF_DIR="/etc/mihomo"
CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"
    CLEAN="/tmp/clean_$$.yaml"
    FINAL="/tmp/final_$$.yaml"
    trap 'rm -f /tmp/*_$$.yaml /tmp/cfg_err.log' EXIT

    # Line endings & cleanup
    tr -d '\r' > "$TMP"
    echo "" >> "$TMP"

    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr 2>/dev/null || echo "192.168.1.1")

        # ⚡ 1. Root Block Extraction (Preserves Indentation & Objects Verbatim)
        awk '
        BEGIN { in_block = 0 }
        /^[a-zA-Z0-9_-]+:[[:space:]]*/ {
            key = $1
            sub(/:.*/, "", key)
            if (key ~ /^(proxies|proxy-groups|proxy-providers|rule-providers)$/) {
                in_block = 1
            } else {
                in_block = 0
            }
        }
        {
            if (in_block == 1) {
                print $0
            }
        }' "$TMP" > "$CLEAN"

        echo "" >> "$CLEAN"

        # ⚡ 2. Master Optimized System Header
        cat << 'HEOF' > "$FINAL"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
allow-lan: true
bind-address: '*'
mode: rule
log-level: silent
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

find-process-mode: 'off'
tcp-concurrent: true
unified-delay: true

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  respect-rules: true
  proxy-server-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
  direct-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'time.*.com'
    - 'ntp.*.com'
    - '+.microsoft.com'
    - '+.xboxlive.com'
    - '+.playvalorant.com'
    - '+.riotgames.com'
HEOF

        # Merge extracted proxy sections
        echo "" >> "$FINAL"
        cat "$CLEAN" >> "$FINAL"
        echo "" >> "$FINAL"

        # Inject default group if missing
        if ! grep -q "^proxy-groups:" "$FINAL"; then
            cat << 'GEOF' >> "$FINAL"

proxy-groups:
  - name: "🌀 Uzumaki-Auto"
    type: select
    proxies:
      - DIRECT
GEOF
            echo "" >> "$FINAL"
        fi

        # Detect main active group
        MAIN_GROUP=$(grep -A 5 "^proxy-groups:" "$FINAL" 2>/dev/null | grep "name:" | head -n 1 | sed 's/.*name:[ '\''"]*//;s/['\''"]*$//' | tr -d '\r\n"')
        [ -z "$MAIN_GROUP" ] && MAIN_GROUP="🌀 Uzumaki-Auto"

        # ⚡ 3. Inject Clean Master Rules
        cat << REOF >> "$FINAL"

rules:
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - NETWORK,udp,DIRECT
  - DOMAIN-SUFFIX,riotgames.com,DIRECT
  - DOMAIN-SUFFIX,playvalorant.com,DIRECT
  - DOMAIN-SUFFIX,pvp.net,DIRECT
  - DOMAIN-SUFFIX,leagueoflegends.com,DIRECT
  - DOMAIN-KEYWORD,riot,DIRECT
  - DOMAIN-KEYWORD,valorant,DIRECT
  - DOMAIN-SUFFIX,microsoft.com,DIRECT
  - DOMAIN-SUFFIX,windows.com,DIRECT
  - DOMAIN-SUFFIX,xboxlive.com,DIRECT
  - DOMAIN-KEYWORD,microsoft,DIRECT
  - DOMAIN-SUFFIX,bd,DIRECT
  - DOMAIN-KEYWORD,bkash,DIRECT
  - MATCH,"$MAIN_GROUP"
REOF

        # ⚡ 4. Mihomo Core Validation
        $CORE -d "$CONF_DIR" -f "$FINAL" -t > /tmp/cfg_err.log 2>&1
        if [ $? -eq 0 ]; then
            mv "$FINAL" "$CONF_DIR/config.yaml"
            /etc/init.d/mihomo restart >/dev/null 2>&1

            (
                sleep 2
                ENCODED_GROUP=$(echo "$MAIN_GROUP" | sed 's/ /%20/g')
                FIRST_NODE=$(curl -4 -s --max-time 5 -H "Authorization: Bearer flclash123" "http://127.0.0.1:9595/proxies/$ENCODED_GROUP" | grep -o '"all":\[[^]]*\]' | head -n 1 | sed 's/.*"all":\["//;s/".*//' | tr -d '"')
                if [ -n "$FIRST_NODE" ] && [ "$FIRST_NODE" != "DIRECT" ]; then
                    curl -4 -s --max-time 5 -X PUT -H "Authorization: Bearer flclash123" -H "Content-Type: application/json" -d "{\"name\":\"$FIRST_NODE\"}" "http://127.0.0.1:9595/proxies/$ENCODED_GROUP" >/dev/null 2>&1
                fi
            ) &

            echo "SAVED"
        else
            ERR_MSG=$(grep -i "error\|fatal\|failed" /tmp/cfg_err.log | head -n 1)
            [ -z "$ERR_MSG" ] && ERR_MSG=$(tail -n 2 /tmp/cfg_err.log | tr '\n' ' ')
            echo "INVALID YAML: $ERR_MSG"
        fi
    fi
else
    cat "$CONF_DIR/config.yaml" 2>/dev/null
fi
