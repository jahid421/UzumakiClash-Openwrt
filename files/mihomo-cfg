#!/bin/sh
echo "Content-Type: text/plain"
echo ""
CONF_DIR="/etc/mihomo"; CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"; CLEAN="/tmp/clean_$$.yaml"; FINAL="/tmp/final_$$.yaml"
    trap "rm -f /tmp/*_$$.yaml /tmp/cfg_err.log" EXIT
    tr -d '\r' > "$TMP"
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        
        # তোর অরিজিনাল ফিল্টার
        awk 'BEGIN { skip=0 } /^[a-zA-Z0-9_-]+:/ { key=$1; if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns|sniffer|profile):/) skip=1; else skip=0 } { if (!skip) print $0 }' "$TMP" > "$CLEAN"

        # তোর অরিজিনাল কনফিগ টেমপ্লেট
        cat << HEOF > "$FINAL"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

# ⚡ Performance Boost (Fixed IDM & Speed delay)
tcp-concurrent: true
unified-delay: false
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
  nameserver: [1.1.1.1, 8.8.8.8, 1.0.0.1]
  proxy-server-nameserver: [1.1.1.1]
  respect-rules: true
HEOF

        # তোর অরিজিনাল রুলস ইনজেকশন
        awk -v lan="$LAN_IP" '/^rules:/ {
            print $0
            print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
            print "  # 🌀 Gaming & CDN Bypass (Fixed MS Store & Riot)"
            print "  - DOMAIN-KEYWORD,riotgames,DIRECT\n  - DOMAIN-KEYWORD,playvalorant,DIRECT\n  - DOMAIN-SUFFIX,pvp.net,DIRECT"
            print "  - DOMAIN-KEYWORD,microsoft,DIRECT\n  - DOMAIN-KEYWORD,windows,DIRECT\n  - DOMAIN-KEYWORD,ultraviewer,DIRECT"
            print "  - DOMAIN-SUFFIX,bd,DIRECT\n  - DOMAIN-KEYWORD,bkash,DIRECT"
            next
        } { print }' "$CLEAN" >> "$FINAL"

        # মিহোমো কোরের নিজস্ব ফাস্ট ভ্যালিডেশন টেস্ট রান
        $CORE -d $CONF_DIR -f "$FINAL" -t > /tmp/cfg_err.log 2>&1
        TEST_STATUS=$? # টেস্টের এক্সিট কোড সরাসরি রিড করা হলো (Busybox-এ ১০০% সেফ)

        if [ $TEST_STATUS -eq 0 ]; then
            mv "$FINAL" $CONF_DIR/config.yaml
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            # টেস্ট ফেইল করলে আসল এরর মেসেজটি শো করবে
            ACTUAL_ERR=$(tail -n 2 /tmp/cfg_err.log | tr '\n' ' ')
            echo "INVALID YAML: $ACTUAL_ERR"
        fi
    fi
else
    cat $CONF_DIR/config.yaml 2>/dev/null
fi
