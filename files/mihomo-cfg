#!/bin/sh

echo "Content-Type: text/plain"
echo ""

CONF_DIR="/etc/mihomo"
CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then

    TMP="/tmp/raw_$$.yaml"
    CLEAN="/tmp/clean_$$.yaml"
    FINAL="/tmp/final_$$.yaml"
    ERR="/tmp/cfg_err_$$.log"

    cleanup() {
        rm -f \
            "$TMP" \
            "$CLEAN" \
            "$FINAL" \
            "$ERR"
    }

    trap cleanup EXIT

    # ==========================================================
    # Read uploaded config
    # ==========================================================
    tr -d '\r' > "$TMP"

    if [ ! -s "$TMP" ]; then
        echo "EMPTY_CONFIG"
        exit 1
    fi

    # ==========================================================
    # Strip only top-level gateway blocks that Uzumaki controls.
    #
    # Keep:
    # proxies
    # proxy-groups
    # proxy-providers
    # rules
    # rule-providers
    # hosts
    # hosts-related settings
    # other user configuration
    # ==========================================================
    awk '
    function managed(k) {

        return (
            k == "port" ||
            k == "socks-port" ||
            k == "mixed-port" ||
            k == "redir-port" ||
            k == "tproxy-port" ||
            k == "allow-lan" ||
            k == "bind-address" ||
            k == "mode" ||
            k == "log-level" ||
            k == "ipv6" ||
            k == "external-controller" ||
            k == "external-ui" ||
            k == "secret" ||
            k == "tcp-concurrent" ||
            k == "unified-delay" ||
            k == "global-client-fingerprint" ||
            k == "profile" ||
            k == "dns" ||
            k == "sniffer"
        )
    }

    /^[^[:space:]][^:]*:/ {

        key=$0
        sub(/:.*/, "", key)

        if (managed(key)) {
            skip=1
            next
        }

        skip=0
        print
        next
    }

    /^[[:space:]]+/ {

        if (skip==0) {
            print
        }

        next
    }

    {
        if (skip==0) {
            print
        }
    }
    ' "$TMP" > "$CLEAN"

    # ==========================================================
    # Uzumaki controlled base configuration
    # ==========================================================
    cat <<'UZ_CONFIG' > "$FINAL"

mixed-port: 7890
redir-port: 7892
tproxy-port: 7893

allow-lan: true
bind-address: '*'

mode: rule
log-level: warning
ipv6: false

external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

tcp-concurrent: true
unified-delay: false
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  override-destination: true

  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880

    TLS:
      ports:
        - 443
        - 8443

    QUIC:
      ports:
        - 443
        - 8443

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false

  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'localhost'

    - 'time.*.com'
    - 'ntp.*.com'
    - '+.pool.ntp.org'

    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - '+.microsoft.com'
    - '+.microsoftonline.com'
    - '+.windows.com'
    - '+.windows.net'
    - '+.windowsupdate.com'
    - '+.live.com'

    - '+.riotgames.com'
    - '+.riotcdn.net'
    - '+.playvalorant.com'
    - '+.pvp.net'
    - '+.leagueoflegends.com'

    - '+.ultraviewer.net'
    - '+.ultraviewer.com'

  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8

  proxy-server-nameserver:
    - 1.1.1.1
    - 8.8.8.8

  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 1.0.0.1

UZ_CONFIG

    # ==========================================================
    # Preserve user's config
    # ==========================================================
    cat "$CLEAN" >> "$FINAL"

    # ==========================================================
    # Default proxy group only if imported config has none.
    # ==========================================================
    if ! grep -q '^proxy-groups:' "$FINAL"; then

        cat <<'UZ_GROUP' >> "$FINAL"

proxy-groups:
  - name: "🌀 Uzumaki-Auto"
    type: url-test
    proxies:
      - DIRECT
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 30
    lazy: true

UZ_GROUP

    fi

    # ==========================================================
    # Default rules only if imported config has none.
    # ==========================================================
    if ! grep -q '^rules:' "$FINAL"; then

        cat <<'UZ_RULES' >> "$FINAL"

rules:

  - 'IP-CIDR,127.0.0.0/8,DIRECT,no-resolve'
  - 'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve'
  - 'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve'
  - 'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve'
  - 'IP-CIDR,169.254.0.0/16,DIRECT,no-resolve'

  - 'DOMAIN-SUFFIX,local,DIRECT'
  - 'DOMAIN-SUFFIX,lan,DIRECT'

  - 'DOMAIN-SUFFIX,microsoft.com,DIRECT'
  - 'DOMAIN-SUFFIX,microsoftonline.com,DIRECT'
  - 'DOMAIN-SUFFIX,windows.com,DIRECT'
  - 'DOMAIN-SUFFIX,windows.net,DIRECT'
  - 'DOMAIN-SUFFIX,windowsupdate.com,DIRECT'
  - 'DOMAIN-SUFFIX,live.com,DIRECT'
  - 'DOMAIN-SUFFIX,msftconnecttest.com,DIRECT'
  - 'DOMAIN-SUFFIX,msftncsi.com,DIRECT'

  - 'DOMAIN-SUFFIX,ultraviewer.net,DIRECT'
  - 'DOMAIN-SUFFIX,ultraviewer.com,DIRECT'

  - 'DOMAIN-SUFFIX,riotgames.com,🌀 Uzumaki-Auto'
  - 'DOMAIN-SUFFIX,riotcdn.net,🌀 Uzumaki-Auto'
  - 'DOMAIN-SUFFIX,playvalorant.com,🌀 Uzumaki-Auto'
  - 'DOMAIN-SUFFIX,pvp.net,🌀 Uzumaki-Auto'
  - 'DOMAIN-SUFFIX,leagueoflegends.com,🌀 Uzumaki-Auto'

  - 'DOMAIN-SUFFIX,bd,DIRECT'

  - 'MATCH,🌀 Uzumaki-Auto'

UZ_RULES

    fi

    # ==========================================================
    # Validate with Mihomo
    # ==========================================================
    "$CORE" \
        -d "$CONF_DIR" \
        -f "$FINAL" \
        -t >"$ERR" 2>&1

    RET=$?

    if [ "$RET" -ne 0 ]; then

        echo "INVALID YAML"
        head -n 12 "$ERR"

        exit 1
    fi

    # ==========================================================
    # Backup existing working config
    # ==========================================================
    if [ -f "$CONF_DIR/config.yaml" ]; then

        cp "$CONF_DIR/config.yaml" \
            "$CONF_DIR/config.yaml.bak"

    fi

    # ==========================================================
    # Install new config
    # ==========================================================
    cp "$FINAL" \
        "$CONF_DIR/config.yaml"

    # ==========================================================
    # Restart
    # ==========================================================
    /etc/init.d/mihomo restart \
        >/dev/null 2>&1

    echo "SAVED"

else

    cat "$CONF_DIR/config.yaml" 2>/dev/null

fi
