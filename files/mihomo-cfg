#!/bin/sh
# 🌀 UzumakiClash - Robust YAML Optimizer
echo "Content-Type: text/plain"
echo ""

CONF_DIR="/etc/mihomo"
CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"
    CLEAN="/tmp/clean_$$.yaml"
    FINAL="/tmp/final_$$.yaml"
    trap "rm -f /tmp/*_$$.yaml /tmp/cfg_err.log" EXIT

    # ১. ইনপুট ডাটা ক্লিন করা
    tr -d '\r' > "$TMP"
    
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')

        # ২. আগের গ্লোবাল সেটিংস রিমুভ করা
        awk 'BEGIN { skip=0 } /^[a-zA-Z0-9_-]+:/ { key=$1; if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns|sniffer|profile):/) skip=1; else skip=0 } { if (!skip) print $0 }' "$TMP" > "$CLEAN"

        # ৩. ফাইনাল ফাইল জেনারেট করা (সঠিক ইন্ডেন্টেশন সহ)
        cat << HEOF > "$FINAL"
mixed-port: 7890
redir-port: 7892
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"
tcp-concurrent: true
unified-delay: false

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: redir-host
  fake-ip-filter: ['+.riotgames.com', '+.playvalorant.com', '+.pvp.net', '+.microsoft.com']
  nameserver: [1.1.1.1, 8.8.8.8]

HEOF

        # ৪. রুলস ইনজেকশন লজিক
        awk -v lan="$LAN_NET" '
        BEGIN { added=0 }
        /^rules:/ {
            print $0
            if (!added) {
                printf "  - IP-CIDR,%s,DIRECT,no-resolve\n", lan
                print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
                print "  - DOMAIN-KEYWORD,riotgames,DIRECT"
                print "  - DOMAIN-KEYWORD,playvalorant,DIRECT"
                print "  - DOMAIN-SUFFIX,pvp.net,DIRECT"
                print "  - DOMAIN-KEYWORD,microsoft,DIRECT"
                print "  - DOMAIN-KEYWORD,ultraviewer,DIRECT"
                added=1
            }
            next
        }
        { print }' "$CLEAN" >> "$FINAL"

        # ৫. ভ্যালিডেশন চেক (এটিই আসল কাজ করবে)
        if $CORE -d $CONF_DIR -f "$FINAL" -t > /tmp/cfg_err.log 2>&1; then
            mv "$FINAL" $CONF_DIR/config.yaml
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            echo "INVALID YAML: $(head -n 1 /tmp/cfg_err.log)"
        fi
    else
        echo "EMPTY_INPUT"
    fi
else
    cat $CONF_DIR/config.yaml 2>/dev/null
fi
