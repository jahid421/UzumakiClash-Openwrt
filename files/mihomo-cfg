#!/bin/sh
# ═══════════════════════════════════════════════
# 🌀 UzumakiClash - Bulletproof Config Optimizer
# ═══════════════════════════════════════════════

echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/user_raw_$$.yaml"
    TMP_CLEAN="/tmp/user_clean_$$.yaml"
    TMP_FINAL="/tmp/user_final_$$.yaml"
    trap "rm -f /tmp/user_*_$$.yaml /tmp/uzcfg_err.log" EXIT

    tr -d '\r' > "$TMP"

    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')

        # সিস্টেম হেডার বাদ দিয়ে শুধু নোড ও রুলস নেওয়া
        awk '
        BEGIN { skip=0 }
        /^[a-zA-Z0-9_-]+:/ {
            key = $1
            if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns):/) {
                skip=1
            } else {
                skip=0
            }
        }
        { if (!skip) print $0 }
        ' "$TMP" > "$TMP_CLEAN"

        # রুলস সেকশনে লোকাল, বাংলাদেশি ও রিমোট ডেস্কটপ বাইপাস ইনজেক্ট করা
        awk -v lan="$LAN_NET" '
        BEGIN { added=0 }
        /^rules:/ {
            print $0
            if (!added) {
                print "  # LAN Safety"
                print "  - IP-CIDR," lan ",DIRECT,no-resolve"
                print "  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
                print "  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
                print "  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
                print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
                print "  - DOMAIN-SUFFIX,local,DIRECT"
                print "  - DOMAIN-SUFFIX,lan,DIRECT"
                print "  - DST-PORT,9595,DIRECT"
                print "  # Remote Desktop (DIRECT Bypass)"
                print "  - DOMAIN-KEYWORD,ultraviewer,DIRECT"
                print "  - DOMAIN-SUFFIX,ultraviewer.net,DIRECT"
                print "  - DOMAIN-KEYWORD,anydesk,DIRECT"
                print "  - DOMAIN-SUFFIX,anydesk.com,DIRECT"
                print "  - DOMAIN-KEYWORD,teamviewer,DIRECT"
                print "  - DOMAIN-SUFFIX,teamviewer.com,DIRECT"
                print "  - DOMAIN-KEYWORD,rustdesk,DIRECT"
                print "  # Bangladesh Apps (DIRECT)"
                print "  - DOMAIN-SUFFIX,bd,DIRECT"
                print "  - DOMAIN-KEYWORD,bkash,DIRECT"
                print "  - DOMAIN-KEYWORD,nagad,DIRECT"
                print "  - DOMAIN-KEYWORD,rocket,DIRECT"
                print "  - DOMAIN-KEYWORD,daraz,DIRECT"
                print "  - DOMAIN-KEYWORD,chorki,DIRECT"
                print "  - DOMAIN-KEYWORD,hoichoi,DIRECT"
                added=1
            }
            next
        }
        { print }
        ' "$TMP_CLEAN" > "$TMP"

        cat << 'HEOF' > "$TMP_FINAL"
mixed-port: 7890
redir-port: 7892
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"
tcp-concurrent: true
unified-delay: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'time.*.com'
    - 'ntp.*.com'
    - '+.pool.ntp.org'
    - '+.ultraviewer.net'
    - '+.anydesk.com'
    - '+.teamviewer.com'
    - '+.rustdesk.com'
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - https://dns.google/dns-query

HEOF
        cat "$TMP" >> "$TMP_FINAL"

        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP_FINAL" -t 2>/tmp/uzcfg_err.log; then
            mv "$TMP_FINAL" /etc/mihomo/config.yaml
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            killall -9 mihomo 2>/dev/null || true
            /usr/bin/mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml > /dev/null 2>&1 &
            echo "SAVED"
        else
            ERR=$(head -n 3 /tmp/uzcfg_err.log 2>/dev/null)
            echo "INVALID YAML: $ERR"
        fi
    else
        echo "EMPTY"
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
