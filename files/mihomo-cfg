#!/bin/sh

echo "Content-Type: text/plain"
echo ""

CONF_DIR="/etc/mihomo"
CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then

    TMP="/tmp/uz_cfg_$$.yaml"
    ERR="/tmp/uz_cfg_err_$$.log"

    trap 'rm -f "$TMP" "$ERR"' EXIT

    # Read uploaded YAML from stdin
    cat > "$TMP"

    if [ ! -s "$TMP" ]; then
        echo "ERROR: EMPTY_CONFIG"
        exit 1
    fi

    # Remove Windows CRLF
    sed -i 's/\r$//' "$TMP"

    # Basic YAML sanity check
    if ! grep -qE '^(proxies:|proxy-providers:|proxy-groups:|rules:)' "$TMP"; then
        echo "ERROR: INVALID_CLASH_CONFIG"
        exit 1
    fi

    # Validate config with Mihomo
    "$CORE" -d "$CONF_DIR" -f "$TMP" -t > "$ERR" 2>&1

    if [ $? -ne 0 ]; then
        echo "INVALID_CONFIG"
        head -n 8 "$ERR"
        exit 1
    fi

    # Backup current working config
    if [ -f "$CONF_DIR/config.yaml" ]; then
        cp "$CONF_DIR/config.yaml" \
           "$CONF_DIR/config.yaml.bak"
    fi

    # Install uploaded config WITHOUT destroying:
    # proxies / proxy-providers / proxy-groups / rules
    cp "$TMP" "$CONF_DIR/config.yaml"

    chmod 644 "$CONF_DIR/config.yaml"

    # Restart Mihomo cleanly
    /etc/init.d/mihomo restart >/dev/null 2>&1

    sleep 2

    # Verify process
    if pgrep -f "/usr/bin/mihomo" >/dev/null 2>&1; then
        echo "SAVED"
        exit 0
    fi

    # Restore previous config if restart failed
    if [ -f "$CONF_DIR/config.yaml.bak" ]; then
        cp "$CONF_DIR/config.yaml.bak" \
           "$CONF_DIR/config.yaml"
        /etc/init.d/mihomo restart >/dev/null 2>&1
    fi

    echo "ERROR: MIHOMO_FAILED_TO_START"
    exit 1

else

    # GET = return current config
    if [ -f "$CONF_DIR/config.yaml" ]; then
        cat "$CONF_DIR/config.yaml"
    else
        echo "ERROR: CONFIG_NOT_FOUND"
        exit 1
    fi

fi
