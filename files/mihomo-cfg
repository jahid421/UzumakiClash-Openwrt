#!/bin/sh
echo "Content-Type: text/plain"
echo ""
CONF_DIR="/etc/mihomo"; CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"; CLEAN="/tmp/clean_$$.yaml"; FINAL="/tmp/final_$$.yaml"
    trap "rm -f /tmp/*_$$.yaml /tmp/cfg_err.log" EXIT
    tr -d '\r' > "$TMP"
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        awk 'BEGIN { skip=0 } /^[a-zA-Z0-9_-]+:/ { key=$1; if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns|sniffer|profile):/) skip=1; else skip=0 } { if (!skip) print $0 }' "$TMP" > "$CLEAN"

        cat << HEOF > "$FINAL"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"
tcp-concurrent: true
unified-delay: true
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '+.microsoft.com'
    - '+.xboxlive.com'
    - '+.playvalorant.com'
    - '+.riotgames.com'
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
HEOF

        if grep -q "^rules:" "$CLEAN"; then
            awk '/^rules:/ {
                print $0
                print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
                print "  - NETWORK,udp,DIRECT"
                print "  - DOMAIN-SUFFIX,riotgames.com,DIRECT"
                print "  - DOMAIN-SUFFIX,playvalorant.com,DIRECT"
                print "  - DOMAIN-SUFFIX,pvp.net,DIRECT"
                print "  - DOMAIN-SUFFIX,microsoft.com,DIRECT"
                print "  - DOMAIN-SUFFIX,windows.com,DIRECT"
                print "  - DOMAIN-SUFFIX,xboxlive.com,DIRECT"
                print "  - DOMAIN-KEYWORD,riotgames,DIRECT"
                print "  - DOMAIN-KEYWORD,playvalorant,DIRECT"
                print "  - DOMAIN-KEYWORD,microsoft,DIRECT"
                print "  - DOMAIN-SUFFIX,bd,DIRECT"
                print "  - DOMAIN-KEYWORD,bkash,DIRECT"
                next
            } { print }' "$CLEAN" >> "$FINAL"
        else
            cat "$CLEAN" >> "$FINAL"
            cat << 'REOF' >> "$FINAL"
rules:
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - NETWORK,udp,DIRECT
  - DOMAIN-SUFFIX,riotgames.com,DIRECT
  - DOMAIN-SUFFIX,playvalorant.com,DIRECT
  - DOMAIN-SUFFIX,pvp.net,DIRECT
  - DOMAIN-SUFFIX,microsoft.com,DIRECT
  - DOMAIN-SUFFIX,windows.com,DIRECT
  - DOMAIN-KEYWORD,riotgames,DIRECT
  - DOMAIN-KEYWORD,microsoft,DIRECT
  - DOMAIN-SUFFIX,bd,DIRECT
  - DOMAIN-KEYWORD,bkash,DIRECT
  - MATCH,DIRECT
REOF
        fi

        $CORE -d $CONF_DIR -f "$FINAL" -t > /tmp/cfg_err.log 2>&1
        if ! grep -qi "level=fatal\|level=error\|failed" /tmp/cfg_err.log; then
            mv "$FINAL" $CONF_DIR/config.yaml
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            ERR_MSG=$(grep -i "error\|fatal\|failed" /tmp/cfg_err.log | head -n 1)
            [ -z "$ERR_MSG" ] && ERR_MSG=$(tail -n 2 /tmp/cfg_err.log | tr '\n' ' ')
            echo "INVALID YAML: $ERR_MSG"
        fi
    fi
else
    cat $CONF_DIR/config.yaml 2>/dev/null
fi
