#!/bin/sh
echo "Content-Type: text/plain"
echo ""
CONF_DIR="/etc/mihomo"; CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"; CLEAN="/tmp/clean_$$.yaml"; FINAL="/tmp/final_$$.yaml"
    trap "rm -f /tmp/*_$$.yaml /tmp/cfg_err.log" EXIT
    tr -d '\r' > "$TMP"
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        
        # Strip old bulky global settings
        awk 'BEGIN { skip=0 } /^[a-zA-Z0-9_-]+:/ { key=$1; if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns|sniffer|profile|tun):/) skip=1; else skip=0 } { if (!skip) print $0 }' "$TMP" > "$CLEAN"

        cat << HEOF > "$FINAL"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

# ⚡ Performance Boost
tcp-concurrent: true
unified-delay: false
global-client-fingerprint: chrome

profile:
  store-selected: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: redir-host
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 1.0.0.1
  proxy-server-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  respect-rules: true
HEOF

        # Smart detection of primary proxy group from the uploaded sub
        MAIN_GROUP=$(awk '
        /^proxy-groups:/ { pg=1; next }
        pg && /^[[:space:]]*- name:/ {
            sub(/^[[:space:]]*- name:[[:space:]]*/, "")
            gsub(/^["'"'"']|["'"'"']$/, "")
            print $0
            exit
        }
        ' "$CLEAN")
        [ -z "$MAIN_GROUP" ] && MAIN_GROUP="GLOBAL"

        awk -v mg="$MAIN_GROUP" -v lan="$LAN_IP" '
        BEGIN { in_rules=0 }
        /^rules:/ {
            in_rules=1
            print $0
            print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
            print "  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
            print "  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
            print "  # 🌀 Gaming & CDN Bypass (Fixed UltraViewer, MS Store & Riot)"
            print "  - DOMAIN-KEYWORD,riotgames,DIRECT"
            print "  - DOMAIN-KEYWORD,playvalorant,DIRECT"
            print "  - DOMAIN-SUFFIX,pvp.net,DIRECT"
            print "  - DOMAIN-KEYWORD,microsoft,DIRECT"
            print "  - DOMAIN-KEYWORD,windows,DIRECT"
            print "  - DOMAIN-KEYWORD,ultraviewer,DIRECT"
            print "  - DOMAIN-SUFFIX,bd,DIRECT"
            print "  - DOMAIN-KEYWORD,bkash,DIRECT"
            print "  - DOMAIN-SUFFIX,speedtest.net,DIRECT"
            print "  - DST-PORT,9595,DIRECT"
            next
        }
        in_rules && /^[[:space:]]*- MATCH,/ { next }
        in_rules && /^[a-zA-Z0-9_-]+:/ {
            in_rules=0
            print "  - MATCH," mg
        }
        { print }
        END {
            if (in_rules) {
                print "  - MATCH," mg
            }
        }' "$CLEAN" >> "$FINAL"

        $CORE -d $CONF_DIR -f "$FINAL" -t > /tmp/cfg_err.log 2>&1
        if ! grep -qi "level=fatal\|level=error" /tmp/cfg_err.log; then
            mv "$FINAL" $CONF_DIR/config.yaml
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            echo "INVALID YAML: $(head -n 2 /tmp/cfg_err.log)"
        fi
    fi
else
    cat $CONF_DIR/config.yaml 2>/dev/null
fi
