#!/bin/sh

echo "Content-Type: text/plain"
echo ""

CONF_DIR="/etc/mihomo"
CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then

    TMP="/tmp/raw_$$.yaml"
    CLEAN="/tmp/clean_$$.yaml"
    FINAL="/tmp/final_$$.yaml"
    ERR="/tmp/cfg_err_$$.log"

    cleanup() {

        rm -f \
            "$TMP" \
            "$CLEAN" \
            "$FINAL" \
            "$ERR"

    }

    trap cleanup EXIT

    # ==========================================================
    # READ USER YAML
    # ==========================================================
    tr -d '\r' > "$TMP"

    if [ ! -s "$TMP" ]; then
        echo "EMPTY_CONFIG"
        exit 1
    fi

    # ==========================================================
    # REMOVE ONLY TOP-LEVEL SETTINGS OWNED BY UZUMAKICLASH.
    #
    # IMPORTANT:
    # proxies
    # proxy-groups
    # proxy-providers
    # rules
    # rule-providers
    # listeners
    # hosts
    # other user blocks
    # are preserved.
    # ==========================================================
    awk '
    function managed(key) {

        return (
            key == "port" ||
            key == "socks-port" ||
            key == "mixed-port" ||
            key == "redir-port" ||
            key == "tproxy-port" ||
            key == "allow-lan" ||
            key == "bind-address" ||
            key == "mode" ||
            key == "log-level" ||
            key == "ipv6" ||
            key == "external-controller" ||
            key == "external-ui" ||
            key == "secret" ||
            key == "tcp-concurrent" ||
            key == "unified-delay" ||
            key == "global-client-fingerprint" ||
            key == "profile" ||
            key == "dns" ||
            key == "sniffer"
        )
    }

    /^[^[:space:]][^:]*:/ {

        key=$0
        sub(/:.*/, "", key)

        if (managed(key)) {

            skip=1
            next

        }

        skip=0
        print
        next
    }

    /^[[:space:]]/ {

        if (skip == 0) {
            print
        }

        next
    }

    {
        if (skip == 0) {
            print
        }
    }
    ' "$TMP" > "$CLEAN"

    # ==========================================================
    # UZUMAKI CONTROLLED CONFIG
    # ==========================================================
    cat <<'UZ_CONFIG' > "$FINAL"

mixed-port: 7890
redir-port: 7892
tproxy-port: 7893

allow-lan: true
bind-address: '*'

mode: rule
log-level: warning
ipv6: false

external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

tcp-concurrent: true
unified-delay: false
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  override-destination: true

  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880

    TLS:
      ports:
        - 443
        - 8443

    QUIC:
      ports:
        - 443
        - 8443

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false

  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'localhost'

    - 'time.*.com'
    - 'ntp.*.com'
    - '+.pool.ntp.org'

    - '+.msftconnecttest.com'
    - '+.msftncsi.com'

    - '+.microsoft.com'
    - '+.microsoftonline.com'
    - '+.windows.com'
    - '+.windows.net'
    - '+.windowsupdate.com'
    - '+.live.com'

    - 'storeedgefd.dsx.mp.microsoft.com'
    - 'livetileedge.dsx.mp.microsoft.com'
    - 'displaycatalog.mp.microsoft.com'
    - 'dl.delivery.mp.microsoft.com'
    - 'delivery.mp.microsoft.com'
    - 'update.microsoft.com'

    - 'img-prod-cms-rt-microsoft-com.akamaized.net'
    - 'img-s-msn-com.akamaized.net'

    - '+.wns.windows.com'

    - '+.riotgames.com'
    - '+.riotcdn.net'
    - '+.playvalorant.com'
    - '+.pvp.net'
    - '+.leagueoflegends.com'

    - '+.ultraviewer.net'
    - '+.ultraviewer.com'

  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8

  proxy-server-nameserver:
    - 1.1.1.1
    - 8.8.8.8

  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 1.0.0.1

UZ_CONFIG

    # ==========================================================
    # PRESERVE USER CONFIGURATION
    # ==========================================================
    cat "$CLEAN" >> "$FINAL"

    # ==========================================================
    # APP COMPATIBILITY RULES
    #
    # These are inserted BEFORE the user's existing rules so
    # problematic application traffic is kept direct.
    # ==========================================================
    if grep -q '^rules:' "$FINAL"; then

        awk '
        /^rules:/ {

            print

            print "  - '\''IP-CIDR,127.0.0.0/8,DIRECT,no-resolve'\''"
            print "  - '\''IP-CIDR,10.0.0.0/8,DIRECT,no-resolve'\''"
            print "  - '\''IP-CIDR,172.16.0.0/12,DIRECT,no-resolve'\''"
            print "  - '\''IP-CIDR,192.168.0.0/16,DIRECT,no-resolve'\''"
            print "  - '\''IP-CIDR,169.254.0.0/16,DIRECT,no-resolve'\''"

            print "  - '\''DOMAIN-SUFFIX,lan,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,local,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,microsoftonline.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,windows.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,windows.net,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,windowsupdate.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,live.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,msftconnecttest.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,msftncsi.com,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,storeedgefd.dsx.mp.microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,livetileedge.dsx.mp.microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,displaycatalog.mp.microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,dl.delivery.mp.microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,delivery.mp.microsoft.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,update.microsoft.com,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,img-prod-cms-rt-microsoft-com.akamaized.net,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,img-s-msn-com.akamaized.net,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,wns.windows.com,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,ultraviewer.net,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,ultraviewer.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,anydesk.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,teamviewer.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,rustdesk.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,parsec.app,DIRECT'\''"
            print "  - '\''DST-PORT,2112,DIRECT'\''"

            print "  - '\''DOMAIN-SUFFIX,riotgames.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,riotcdn.net,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,playvalorant.com,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,pvp.net,DIRECT'\''"
            print "  - '\''DOMAIN-SUFFIX,leagueoflegends.com,DIRECT'\''"

            print "  - '\''DST-PORT,2099,DIRECT'\''"
            print "  - '\''DST-PORT,5222,DIRECT'\''"
            print "  - '\''DST-PORT,5223,DIRECT'\''"
            print "  - '\''DST-PORT,8088,DIRECT'\''"
            print "  - '\''DST-PORT,8393-8400,DIRECT'\''"

            next
        }

        {
            print
        }
        ' "$FINAL" > "${FINAL}.new"

        mv "${FINAL}.new" "$FINAL"

    fi

    # ==========================================================
    # VALIDATE
    # ==========================================================
    "$CORE" \
        -d "$CONF_DIR" \
        -f "$FINAL" \
        -t >"$ERR" 2>&1

    RET=$?

    if [ "$RET" -ne 0 ]; then

        echo "INVALID YAML"
        head -n 15 "$ERR"

        exit 1

    fi

    # ==========================================================
    # BACKUP
    # ==========================================================
    if [ -f "$CONF_DIR/config.yaml" ]; then

        cp "$CONF_DIR/config.yaml" \
            "$CONF_DIR/config.yaml.bak"

    fi

    # ==========================================================
    # INSTALL
    # ==========================================================
    cp "$FINAL" \
        "$CONF_DIR/config.yaml"

    # ==========================================================
    # RESTART
    # ==========================================================
    if ! /etc/init.d/mihomo restart \
        >/dev/null 2>&1
    then

        echo "SAVED"
        echo "WARNING: Config saved but service restart failed."

        exit 0
    fi

    echo "SAVED"

else

    cat "$CONF_DIR/config.yaml" 2>/dev/null

fi
