#!/bin/sh
echo "Content-Type: text/plain"
echo ""

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/user_raw_$$.yaml"
    TMP_CLEAN="/tmp/user_clean_$$.yaml"
    TMP_FINAL="/tmp/user_final_$$.yaml"
    trap "rm -f /tmp/user_*_$$.yaml /tmp/uzcfg_err.log" EXIT

    tr -d '\r' > "$TMP"

    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        LAN_NET=$(echo "$LAN_IP" | awk -F. '{print $1"."$2"."$3".0/24"}')

        awk '
        BEGIN { skip=0 }
        /^[a-zA-Z0-9_-]+:/ {
            key = $1
            if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns):/) {
                skip=1
            } else {
                skip=0
            }
        }
        { if (!skip) print $0 }
        ' "$TMP" > "$TMP_CLEAN"

        awk -v lan="$LAN_NET" '
        BEGIN { added=0 }
        /^rules:/ {
            print $0
            if (!added) {
                print "  # LAN Safety Direct"
                print "  - IP-CIDR," lan ",DIRECT,no-resolve"
                print "  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
                print "  - DOMAIN-SUFFIX,local,DIRECT"
                print "  - DOMAIN-SUFFIX,lan,DIRECT"
                print "  - DST-PORT,9595,DIRECT"
                print "  # Riot Games Direct"
                print "  - DOMAIN-SUFFIX,riotgames.com,DIRECT"
                print "  - DOMAIN-SUFFIX,riotcdn.net,DIRECT"
                print "  - DOMAIN-KEYWORD,riot,DIRECT"
                print "  # Microsoft Store Turbo Direct (Fixed)"
                print "  - DOMAIN-KEYWORD,microsoft,DIRECT"
                print "  - DOMAIN-KEYWORD,windows,DIRECT"
                print "  - DOMAIN-SUFFIX,microsoft.com,DIRECT"
                print "  - DOMAIN-SUFFIX,windowsupdate.com,DIRECT"
                print "  - DOMAIN-SUFFIX,delivery.mp.microsoft.com,DIRECT"
                print "  - DOMAIN-SUFFIX,msecnd.net,DIRECT"
                print "  # Bangladesh Apps Direct"
                print "  - DOMAIN-SUFFIX,bd,DIRECT"
                print "  - DOMAIN-KEYWORD,bkash,DIRECT"
                print "  - DOMAIN-KEYWORD,nagad,DIRECT"
                added=1
            }
            next
        }
        { print }
        ' "$TMP_CLEAN" > "$TMP"

        cat << 'HEOF' > "$TMP_FINAL"
mixed-port: 7890
redir-port: 7892
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"
tcp-concurrent: true
unified-delay: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '+.microsoft.com'
    - '+.windowsupdate.com'
    - '+.msecnd.net'
    - '+.delivery.mp.microsoft.com'
    - '*.lan'
    - '*.local'
  default-nameserver: [1.1.1.1, 8.8.8.8]
  nameserver: [1.1.1.1, 8.8.8.8]
HEOF
        cat "$TMP" >> "$TMP_FINAL"

        if /usr/bin/mihomo -d /etc/mihomo -f "$TMP_FINAL" -t 2>/tmp/uzcfg_err.log; then
            mv "$TMP_FINAL" /etc/mihomo/config.yaml
            echo "1" > /etc/mihomo/transparent
            echo "1" > /etc/mihomo/enabled
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            echo "INVALID YAML"
        fi
    fi
else
    cat /etc/mihomo/config.yaml 2>/dev/null
fi
