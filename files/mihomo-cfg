#!/bin/sh
echo "Content-Type: text/plain"
echo ""
CONF_DIR="/etc/mihomo"; CORE="/usr/bin/mihomo"

if [ "$REQUEST_METHOD" = "POST" ]; then
    TMP="/tmp/raw_$$.yaml"; CLEAN="/tmp/clean_$$.yaml"; FINAL="/tmp/final_$$.yaml"
    trap "rm -f /tmp/*_$$.yaml /tmp/cfg_err.log" EXIT
    tr -d '\r' > "$TMP"
    if [ -s "$TMP" ]; then
        LAN_IP=$(uci -q get network.lan.ipaddr || echo "192.168.1.1")
        
        # পুরনো গ্লোবাল অপশন ফিল্টার আউট করা
        awk 'BEGIN { skip=0 } /^[a-zA-Z0-9_-]+:/ { key=$1; if (key ~ /^(mixed-port|redir-port|tproxy-port|port|socks-port|allow-lan|bind-address|mode|log-level|ipv6|external-controller|external-ui|secret|dns|sniffer|profile):/) skip=1; else skip=0 } { if (!skip) print $0 }' "$TMP" > "$CLEAN"

        # 🌀 আল্ট্রা গেমিং অপ্টিমাইজড মাস্টার টেমপ্লেট উইথ ফেক-আইপি ফিল্টারস
        cat << HEOF > "$FINAL"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
allow-lan: true
bind-address: '*'
mode: rule
log-level: error
ipv6: false
external-controller: 0.0.0.0:9595
external-ui: /etc/mihomo/ui
secret: "flclash123"

tcp-concurrent: true
unified-delay: false
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  
  # 🎮 Valorant, Vanguard, Discord এবং Microsoft-কে ফেক-আইপি থেকে মুক্ত রাখার ফিল্টার
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'localhost'
    # Riot & Valorant (Anti-Cheat Bypass)
    - '+.riotgames.com'
    - '+.playvalorant.com'
    - '+.pvp.net'
    - '+.leagueoflegends.com'
    - '+.vanguard.riotgames.com'
    # Steam & Epic Games
    - '+.steampowered.com'
    - '+.steamcommunity.com'
    - '+.steamstatic.com'
    - '+.epicgames.com'
    - '+.unrealengine.com'
    # Microsoft, Windows Update & Xbox
    - '+.microsoft.com'
    - '+.windows.com'
    - '+.windowsupdate.com'
    - '+.msecnd.net'
    - '+.xboxlive.com'
    - '+.xbox.com'
    # Discord Voice Channels (Bypass Voice Lag)
    - '+.discord.gg'
    - '+.discord.media'
    - '+.discordapp.com'
    - '+.discordapp.net'
    # Local Services
    - '+.speedtest.net'
    - 'fast.com'
    - '+.bd'
    - '+.bkash.com'

  nameserver: [1.1.1.1, 8.8.8.8, 1.0.0.1]
  proxy-server-nameserver: [1.1.1.1]
  respect-rules: true
HEOF

        # 🎯 রুলস সেকশনে গেমগুলোর ডাইরেক্ট রুল ইনজেকশন (Direct Bypass)
        awk -v lan="$LAN_IP" '/^rules:/ {
            print $0
            print "  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
            print "  # 🎮 Riot Games & Valorant (100% DIRECT Bypass)"
            print "  - DOMAIN-KEYWORD,riotgames,DIRECT"
            print "  - DOMAIN-KEYWORD,playvalorant,DIRECT"
            print "  - DOMAIN-SUFFIX,pvp.net,DIRECT"
            print "  - DOMAIN-KEYWORD,vanguard,DIRECT"
            print "  - DOMAIN-KEYWORD,vnggames,DIRECT"
            print "  # 🎮 Steam & Epic Games"
            print "  - DOMAIN-KEYWORD,steam,DIRECT"
            print "  - DOMAIN-KEYWORD,epicgames,DIRECT"
            print "  # 🖥️ Microsoft & Windows Update"
            print "  - DOMAIN-KEYWORD,microsoft,DIRECT"
            print "  - DOMAIN-KEYWORD,xbox,DIRECT"
            print "  - DOMAIN-SUFFIX,microsoft.com,DIRECT"
            print "  - DOMAIN-SUFFIX,windowsupdate.com,DIRECT"
            print "  # 🎙️ Discord Channels"
            print "  - DOMAIN-KEYWORD,discord,DIRECT"
            print "  # 🇧🇩 Local BD ISP & bKash"
            print "  - DOMAIN-SUFFIX,bd,DIRECT"
            print "  - DOMAIN-KEYWORD,bkash,DIRECT"
            next
        } { print }' "$CLEAN" >> "$FINAL"

        # টেস্ট রান
        $CORE -d $CONF_DIR -f "$FINAL" -t > /tmp/cfg_err.log 2>&1
        TEST_STATUS=$? # রানটাইম এক্সিট কোড টেস্ট

        if [ $TEST_STATUS -eq 0 ]; then
            mv "$FINAL" $CONF_DIR/config.yaml
            /etc/init.d/mihomo restart >/dev/null 2>&1
            echo "SAVED"
        else
            # লগের শেষ লাইন থেকে আসল এররটি বের করা
            ACTUAL_ERR=$(tail -n 2 /tmp/cfg_err.log | tr '\n' ' ')
            echo "INVALID YAML: $ACTUAL_ERR"
        fi
    fi
else
    cat $CONF_DIR/config.yaml 2>/dev/null
fi
