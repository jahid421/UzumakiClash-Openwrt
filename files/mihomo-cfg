#!/bin/sh
# UzumakiClash Config Validator & Optimizer

CORE="/usr/bin/uzumaki-core"
CONF_DIR="/etc/uzumaki"

case "$1" in
    validate)
        FILE="${2:-$CONF_DIR/config.yaml}"
        if $CORE -t -d $CONF_DIR -f "$FILE" 2>&1 | grep -q "successful"; then
            echo "✓ Config is valid"
            exit 0
        else
            echo "✗ Config is INVALID:"
            $CORE -t -d $CONF_DIR -f "$FILE"
            exit 1
        fi
        ;;
    
    optimize)
        # অপ্রয়োজনীয় প্রক্সি রিমুভ + সাইজ কমানো
        FILE="${2:-$CONF_DIR/config.yaml}"
        BACKUP="${FILE}.bak"
        cp "$FILE" "$BACKUP"
        
        # কমেন্ট রিমুভ
        sed -i '/^\s*#/d;/^\s*$/d' "$FILE"
        echo "✓ Optimized: $(wc -l < $FILE) lines"
        ;;
    
    backup)
        tar -czf /tmp/uzumaki-backup-$(date +%Y%m%d).tar.gz -C /etc uzumaki
        echo "✓ Backup: /tmp/uzumaki-backup-$(date +%Y%m%d).tar.gz"
        ;;
    
    restore)
        [ -f "$2" ] || { echo "✗ Backup file not found"; exit 1; }
        tar -xzf "$2" -C /etc/
        /etc/init.d/uzumaki restart
        echo "✓ Restored & restarted"
        ;;
    
    *)
        echo "Usage: $0 {validate|optimize|backup|restore} [file]"
        ;;
esac
